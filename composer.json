{
    "name": "nawasara/keycloak",
    "description": "Keycloak admin dashboard for Nawasara — user management, sessions, events",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Nawasara\\Keycloak\\": "src/"
        }
    },
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^12.0",
        "spatie/laravel-permission": "^6.0",
        "nawasara/ui": "*",
        "nawasara/vault": "*",
        "livewire/livewire": "^3.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nawasara\\Keycloak\\KeycloakServiceProvider"
            ]
        }
    }
}
